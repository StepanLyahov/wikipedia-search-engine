# PostgreSQL is published locally for inspection; containers use the internal hostname `postgres`.
POSTGRES_PORT=5432
CRAWLER_SEED_URL=https://en.wikipedia.org/wiki/Elasticsearch
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_PAGES=100
CRAWLER_REQUEST_TIMEOUT=15s

# Elasticsearch is published locally for inspection; containers use the internal hostname `elasticsearch`.
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=wiki_pages
INDEXER_REQUEST_TIMEOUT=15s
INDEXER_BATCH_SIZE=500
INDEXER_EMBEDDING_TIMEOUT=15s
INDEXER_EMBEDDING_DIMS=384

# embedding-service is published locally for inspection; containers use the internal hostname
# `embedding-service`.
EMBEDDING_SERVICE_PORT=50051
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_GRPC_MAX_WORKERS=10

# search-api is published locally for querying; containers use the internal hostname `search-api`.
SEARCH_API_PORT=8080
SEARCH_API_REQUEST_TIMEOUT=15s
SEARCH_API_SHUTDOWN_TIMEOUT=5s
SEARCH_API_DEFAULT_SIZE=10
SEARCH_API_MAX_SIZE=100
SEARCH_API_DEFAULT_K=10
SEARCH_API_MAX_K=100
SEARCH_API_NUM_CANDIDATES=100
SEARCH_API_EMBEDDING_TIMEOUT=15s
